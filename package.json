{
  "name": "@caglarutkuguler/cubicle",
  "version": "0.21.4",
  "description": "A live pixel-art office for your AI agents: Paperclip, Claude Code, Codex, Gemini CLI or any JSON feed. KPI board, Telegram alerts, HD themes. Zero dependencies, read-only.",
  "bin": {
    "cubicle": "bin/cubicle.js"
  },
  "scripts": {
    "start": "node bin/cubicle.js",
    "demo": "node bin/cubicle.js & sleep 1 && echo 'Open http://127.0.0.1:3200/?demo'",
    "test": "node test/smoke.js && node --test test/telegram-access.js test/telegram-access-ui.js test/telegram-notifications.js"
  },
  "files": [
    "bin",
    "public",
    "docs/FEED.md",
    "examples",
    "paperclip"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai-agents",
    "agent-orchestration",
    "paperclip",
    "claude-code",
    "codex",
    "cursor",
    "pixel-art",
    "dashboard",
    "visualization",
    "office",
    "paperclip-plugin",
    "ai-office",
    "agent-dashboard",
    "agent-monitoring",
    "multi-agent",
    "llm-agents",
    "gemini-cli",
    "openai-codex",
    "pixel-agents",
    "telegram-bot",
    "kpi-dashboard",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caglarutkuguler/cubicle.git"
  },
  "author": "Çağlar Utku Güler",
  "license": "MIT",
  "homepage": "https://caglarutkuguler.github.io/cubicle/",
  "bugs": {
    "url": "https://github.com/caglarutkuguler/cubicle/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "paperclipPlugin": {
    "manifest": "./paperclip/manifest.mjs",
    "worker": "./paperclip/worker.js",
    "ui": "./public"
  }
}
