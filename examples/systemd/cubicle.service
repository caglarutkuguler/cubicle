[Unit]
Description=Cubicle - live pixel office for Paperclip agents
After=paperclipai.service

[Service]
# Adjust both paths: your node binary and your Cubicle clone
ExecStart=/usr/bin/node %h/cubicle/bin/cubicle.js
# Paperclip and Claude Code in one office instead:
# ExecStart=/usr/bin/node %h/cubicle/bin/cubicle.js --source paperclip,claude-code
Environment=CUBICLE_PORT=3200
Environment=PAPERCLIP_URL=http://127.0.0.1:3100
# Authenticated Paperclip: a chmod 600 file containing the line PAPERCLIP_TOKEN=pcp_...
# EnvironmentFile=%h/.config/cubicle/env
# Telegram (optional), in the same file: CUBICLE_TELEGRAM_TOKEN=123456:ABC... and, for links your
# phone can open, CUBICLE_PUBLIC_URL=http://<this machine's address>:3200 (then also bind to it:
# Environment=CUBICLE_HOST=0.0.0.0). The pairing code is in: journalctl --user -u cubicle | grep /start
# Answering from Telegram (posts a comment on the Paperclip issue): Environment=CUBICLE_TELEGRAM_REPLIES=1
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
