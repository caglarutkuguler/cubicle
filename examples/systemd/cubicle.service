[Unit]
Description=Cubicle - live pixel office for Paperclip agents
After=paperclipai.service

[Service]
# Adjust both paths: your node binary and your Cubicle clone
ExecStart=/usr/bin/node %h/cubicle/bin/cubicle.js
Environment=CUBICLE_PORT=3200
Environment=PAPERCLIP_URL=http://127.0.0.1:3100
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
